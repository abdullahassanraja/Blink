# Blink Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Get your key from https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Check https://ai.google.dev/models for the current Flash model name
VITE_GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Feature 5: Money Identifier Service
VITE_MONEY_URL=https://your-service.onrender.com
